# =============================================================================
# 🧭 GEBOOK — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to `.env` for local development.

BASE_URL=http://localhost:5170
PORT=8780
WEB_PORT=5170
TRUSTED_ORIGINS=http://localhost:5170
# Set to "true" only when the frontend is deployed on a different origin
# than this API (e.g. Vercel frontend + Render/Railway/Fly API). Leave unset
# for local dev and same-origin deploys — it requires HTTPS on both sides.
CROSS_ORIGIN_COOKIES=false

# -----------------------------------------------------------------------------
# 🤖 1. AI CO-PLANNER & FINANCE AI (OpenAI / Gemini / Anthropic / Minimax)
# -----------------------------------------------------------------------------
# For OpenAI: AI_PROVIDER=openai, AI_MODEL=gpt-4o-mini, AI_API_KEY=sk-...
# For Gemini: AI_PROVIDER=openai, AI_MODEL=gemini-2.0-flash, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, AI_API_KEY=...
# For Anthropic: AI_PROVIDER=anthropic, AI_MODEL=claude-3-5-sonnet-20241022, AI_API_KEY=sk-ant-...
# For Groq: AI_PROVIDER=groq, AI_BASE_URL=https://api.groq.com/openai/v1,
#           AI_MODEL=openai/gpt-oss-120b, AI_API_KEY=gsk_...
#           (Groq speaks the OpenAI API; pick a tool-calling model or the
#            co-planner cannot edit the itinerary.)
AI_PROVIDER=openai
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_PROACTIVE_THRESHOLD=0.7
AI_MAX_TOOL_STEPS=16
AI_TELEMETRY_RECORD_CONTENT=false

# -----------------------------------------------------------------------------
# 🗺️ 2. MAPS & GEOCODING (Free OpenStreetMap Default / Google Maps)
# -----------------------------------------------------------------------------
GEO_PROVIDER=osm
GEO_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_OSM_OSRM_URL=https://router.project-osrm.org
GEO_OSM_USER_AGENT=Gebook/0.1 (https://gebook.app; geo-agent)
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 🌦️ 3. LIVE WEATHER FORECASTS (OpenWeatherMap)
# -----------------------------------------------------------------------------
OPENWEATHERMAP_API_KEY=

# -----------------------------------------------------------------------------
# 📸 4. COVER PHOTOS (Unsplash)
# -----------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 🔐 5. AUTH & DATABASE
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://gebook:gebook@localhost:5430/gebook

BETTER_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
REALTIME_GRANT_SECRET=dev-realtime-secret-change-me-0123456789abcdef

EMAIL_PROVIDER=console
EMAIL_FROM=Gebook <noreply@localhost>

STORAGE_BACKEND=fs
STORAGE_ROOT=uploads
