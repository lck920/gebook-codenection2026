{
  "name": "gebook",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Gebook — Gamified Travel Planner SaaS. Plan, budget, and escape together.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @gebook/web --filter @gebook/api --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @gebook/api db:migrate",
    "db:seed": "pnpm --filter @gebook/api db:seed",
    "db:reset": "pnpm --filter @gebook/api db:reset",
    "db:generate": "pnpm --filter @gebook/api db:generate",
    "db:pull": "pnpm --filter @gebook/api db:pull",
    "db:studio": "pnpm --filter @gebook/api db:studio"
  },
  "devDependencies": {
    "@gebook/observability-contract": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
